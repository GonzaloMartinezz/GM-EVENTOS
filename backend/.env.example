# Puerto del servidor
PORT=4000

# Conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://localhost:27017/eventos-tucuman

# Secreto para firmar los JWT del panel admin (cambialo en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Datos del admin que se crea con el seed inicial
ADMIN_EMAIL=admin@eventostucuman.com
ADMIN_PASSWORD=CambiarEsta123!

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173
